# Production database — hosted Postgres (e.g. a free Neon project).
# Paste the pooled connection string here, then run `bunx prisma db push`
# once to create the tables (BookUpload and the rest).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Live Knowledge Base backend — set both to point at a running `kb serve`
# (e.g. http://127.0.0.1:8000). When unset the site serves clearly-labeled
# demo data instead.
KNOWLEDGE_BASE_API_URL=http://127.0.0.1:8000
AI_API_URL=http://127.0.0.1:8000

# --- Book uploads: object storage (production path for real books) ---
# S3-compatible store, e.g. Cloudflare R2. When ALL of these are set,
# /admin/upload streams files directly to the bucket (presigned URLs) so
# ~1000-page volumes bypass serverless body limits. When unset, uploads
# fall back to local disk (dev only).
#
# R2 endpoint looks like: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=islam24x7-books
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the website/app downloads from — an r2.dev subdomain or
# your own domain mapped to the bucket, e.g. https://books.example.com
S3_PUBLIC_BASE_URL=
