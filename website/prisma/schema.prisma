// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Production database is hosted Postgres (e.g. Neon free tier) so book
  // records survive across serverless invocations. Point DATABASE_URL at
  // the pooled connection string and run `prisma db push` once.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Books ingested through the upload console (/admin/upload).
// These rows are the source of truth for files in object storage (R2/S3)
// or on local disk (dev fallback) and are merged into the library
// catalogue served by /api/books, so the Islam24X7 website/app can fetch
// them like any other book. Multi-volume sets (e.g. a 32-volume fatwa
// collection) are stored as one row per volume sharing the same `series`.
model BookUpload {
  id               String   @id @default(cuid())
  title            String
  author           String
  translator       String?
  category         String   @default("other")
  language         String   @default("en")
  description      String?
  publisher        String?
  edition          String?
  license          String?
  // Groups volumes of one work, e.g. "Fatawa Rizvia". Optional.
  series           String?
  // Free-text volume marker, e.g. "Volume 7". Optional.
  volumeLabel      String?
  originalFilename String
  mimeType         String
  // Bytes. Int caps at ~2.1 GB — uploads are capped at 1 GB in config.
  fileSize        Int      @default(0)
  // "local" (dev disk) or "r2" (S3-compatible object storage).
  storage          String   @default("local")
  // Local-disk absolute path (storage = "local").
  storagePath      String   @default("")
  // S3 object key (storage = "r2").
  objectKey        String?
  // Public download URL served to the website/app.
  fileUrl          String   @default("")
  // "uploading" (direct upload in flight) → "ready" (fetchable) |
  // "failed". Reserved for the processing pipeline: "processing".
  status           String   @default("ready")
  pageCount        Int?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
  @@index([category])
  @@index([series])
}